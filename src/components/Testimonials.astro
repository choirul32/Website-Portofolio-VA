---
import SectionHead from "./SectionHead.astro";
import { testimonials } from "../data/site";
---

<section class="sec pt-0" id="reviews">
  <div class="wrap">
    <SectionHead word="Kind words" />
    <div class="mt-9 grid gap-6 md:grid-cols-2 md:gap-5">
      {
        testimonials.map((t) => (
          <blockquote class="m-0 flex flex-col rounded-case border border-line bg-canvas p-8">
            <p class="serif text-[clamp(19px,2.2vw,26px)] italic leading-snug text-ink">
              &ldquo;{t.quote}&rdquo;
            </p>
            <footer class="mt-6 border-t border-line pt-4">
              <p class="text-sm font-bold text-ink">{t.name}</p>
              <p class="mt-0.5 text-xs uppercase tracking-[0.1em] text-muted">{t.detail}</p>
              {t.sample && (
                <p class="mt-2 inline-block rounded-full bg-line/50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted">
                  Sample — real client quote coming
                </p>
              )}
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
