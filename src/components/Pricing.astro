---
import SectionHead from "./SectionHead.astro";
import { packages } from "../data/site";
---

<section class="sec pt-0" id="pricing">
  <div class="wrap">
    <SectionHead word="Packages" />
    <p class="lede max-w-[62ch]">
      Fixed scope, fixed price. No hourly fog — you know exactly what lands on your calendar
      every month.
    </p>
    <div class="mt-9 grid gap-6 lg:grid-cols-3 lg:gap-5">
      {
        packages.map((pkg) => (
          <article
            class:list={[
              "flex flex-col rounded-case p-8",
              pkg.featured
                ? "bg-ink text-canvas shadow-xl shadow-ink/20"
                : "border border-line bg-canvas",
            ]}
          >
            {pkg.featured && (
              <span class="mb-4 inline-block w-fit rounded-full bg-olive px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-canvas">
                Most popular
              </span>
            )}
            <h3 class="font-sans text-xl font-bold uppercase tracking-[-0.01em]">{pkg.name}</h3>
            <p class="mt-3">
              <span class="font-display text-[clamp(40px,4.5vw,56px)] leading-none">{pkg.price}</span>
              <span class:list={["text-sm font-light", pkg.featured ? "text-cream-70" : "text-muted"]}>
                {pkg.per}
              </span>
            </p>
            <p class:list={["mt-3 text-[15px] font-light leading-relaxed", pkg.featured ? "text-cream-70" : "text-body"]}>
              {pkg.desc}
            </p>
            <ul class="mt-6 flex-1">
              {pkg.features.map((feature) => (
                <li
                  class:list={[
                    "border-b py-2.5 text-sm font-light",
                    pkg.featured ? "border-cream-13" : "border-line",
                  ]}
                >
                  {feature}
                </li>
              ))}
            </ul>
            <a
              class:list={["btn mt-7 w-full", pkg.featured ? "btn-cream" : "btn-solid"]}
              href={pkg.cta}
              target="_blank"
              rel="noreferrer"
            >
              Choose {pkg.name}
            </a>
          </article>
        ))
      }
    </div>
    <p class="mt-6 max-w-[62ch] text-sm font-light text-muted">
      Prices in USD. Indonesia-based brand? Ask for Rupiah pricing on WhatsApp — same scope,
      local rate.
    </p>
  </div>
</section>
