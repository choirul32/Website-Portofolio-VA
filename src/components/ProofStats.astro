---
import { stats } from "../data/site";
---

<section class="proof" aria-labelledby="proof-heading">
  <div class="wrap">
    <div class="grid gap-2">
      <span class="kick text-cream-55">Running today</span>
      <span id="proof-heading" class="script !text-[clamp(22px,3vw,34px)] text-cream-90">
        four accounts, every single day
      </span>
    </div>
    <dl class="mt-9 grid grid-cols-2 gap-x-5 gap-y-7 md:grid-cols-4 md:gap-5">
      {
        stats.map((stat) => (
          <div class="proof-cell">
            <dt class="sr-only">{stat.label}</dt>
            <dd class="m-0">
              <span class="proof-n">{stat.value}</span>
              <span class="mt-2 block text-[13px] font-medium">{stat.label}</span>
              <span class="mt-[3px] block text-xs font-light leading-snug text-cream-70">
                {stat.detail}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
