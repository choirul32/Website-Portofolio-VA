---
interface Tile {
  src: string;
  alt: string;
  pos?: string;
  ratio?: "square" | "portrait";
}

interface Props {
  username: string;
  displayName: string;
  bio: string;
  highlights: string[];
  tiles: Tile[];
  caption: string;
  avatarLetter?: string;
  platform?: "instagram" | "tiktok";
}

const { username, displayName, bio, highlights, tiles, caption, avatarLetter = "R", platform = "instagram" } = Astro.props;
const isTikTok = platform === "tiktok";
const shown = tiles.slice(0, 9);
---

<figure class="m-0">
  <div class:list={["mx-auto w-full overflow-hidden rounded-[2rem] border border-line bg-canvas shadow-xl shadow-ink/10", isTikTok ? "max-w-[240px]" : "max-w-[320px]"]}>
    <div class:list={["px-4 py-2 text-center text-[10px] font-semibold uppercase tracking-[0.2em] text-canvas", isTikTok ? "bg-ink" : "bg-brown"]}>
      {isTikTok ? "TikTok preview" : "Concept preview"}
    </div>

    {
      isTikTok ? (
        <div class="flex items-center gap-3 px-4 py-2.5">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink font-serif text-lg font-semibold text-canvas">
            {avatarLetter}
          </div>
          <div class="min-w-0">
            <p class="truncate text-sm font-bold text-ink">{username}</p>
            <p class="truncate text-xs text-muted">{displayName}</p>
          </div>
          <span class="ml-auto shrink-0 rounded-full bg-ink px-3 py-1 text-[11px] font-semibold text-canvas">Follow</span>
        </div>
      ) : (
        <Fragment>
          <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-sm font-bold text-ink">{username}</span>
            <span class="flex gap-3 text-ink" aria-hidden="true">
              <span class="inline-block h-4 w-4 rounded-[4px] border-[1.5px] border-ink" />
              <span class="inline-block h-4 w-4 rounded-full border-[1.5px] border-ink" />
            </span>
          </div>

          <div class="flex items-center gap-4 px-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brown font-serif text-2xl font-semibold text-canvas">
              {avatarLetter}
            </div>
            <div class="flex flex-1 items-center justify-around text-center">
              <div>
                <p class="text-base font-bold text-ink">{tiles.length}</p>
                <p class="text-xs text-muted">Posts</p>
              </div>
              <div>
                <p class="text-base font-bold text-ink">—</p>
                <p class="text-xs text-muted">Followers</p>
              </div>
              <div>
                <p class="text-base font-bold text-ink">—</p>
                <p class="text-xs text-muted">Following</p>
              </div>
            </div>
          </div>

          <div class="px-4 pb-1 pt-2">
            <p class="text-[13px] font-bold text-ink">{displayName}</p>
            <p class="text-[13px] font-light leading-snug text-body">{bio}</p>
          </div>

          <div class="flex gap-2 px-4 py-2">
            <span class="flex-1 rounded-lg bg-ink py-1.5 text-center text-xs font-semibold text-canvas">Follow</span>
            <span class="flex-1 rounded-lg bg-line/50 py-1.5 text-center text-xs font-semibold text-ink">Message</span>
          </div>

          <div class="flex gap-3 overflow-hidden px-4 py-2">
            {
              highlights.map((h) => (
                <div class="flex w-14 shrink-0 flex-col items-center gap-1">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full border border-line bg-line/40 text-[10px] font-bold text-muted">
                    {h.slice(0, 2).toUpperCase()}
                  </span>
                  <span class="w-full truncate text-center text-[10px] text-muted">{h}</span>
                </div>
              ))
            }
          </div>
        </Fragment>
      )
    }

    {
      isTikTok ? (
        <div class="grid grid-cols-3 gap-[2px] bg-line/40">
          {shown.map((tile) => (
            <div class="aspect-[9/16] overflow-hidden bg-line/40">
              <img
                src={tile.src}
                alt={tile.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
                style={tile.pos ? `object-position: ${tile.pos};` : undefined}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-3 gap-[2px] bg-line/40">
          {shown.map((tile) => (
            <div class:list={["overflow-hidden bg-line/40", tile.ratio === "portrait" ? "aspect-[3/4]" : "aspect-square"]}>
              <img
                src={tile.src}
                alt={tile.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
                style={tile.pos ? `object-position: ${tile.pos};` : undefined}
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
  <figcaption class:list={["mx-auto mt-3 text-center text-[13px] font-light text-muted", isTikTok ? "max-w-[240px]" : "max-w-[320px]"]}>
    {caption}
  </figcaption>
</figure>
