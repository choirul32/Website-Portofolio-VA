---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const {
  title,
  description = "TikTok & Instagram publishing for busy brands — hooks, captions, and daily posting in your voice. Packages from $79/mo, free sample to start.",
  currentPage = "",
} = Astro.props;

const pageTitle = currentPage === "home" ? title : `${title} · ${site.shortName}`;
const canonicalUrl = currentPage === "home" ? site.siteUrl : `${site.siteUrl}${Astro.url.pathname}`;
const ogImage = `${site.siteUrl}/og-default.jpg`;

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: `${site.name} — ${site.role}`,
  description,
  url: site.siteUrl,
  email: site.email,
  telephone: site.whatsapp,
  address: { "@type": "PostalAddress", addressCountry: "ID" },
  priceRange: "$79-$379",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="virtual assistant, content VA, TikTok VA, Instagram manager, short-form video editor, social media VA, ecommerce VA, Upwork freelancer Indonesia"
    />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#293A13" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Mrs+Saint+Delafield&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={personSchema} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-[13px] focus:font-semibold focus:uppercase focus:text-canvas"
    >
      Skip to content
    </a>
    <Navigation currentPage={currentPage} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
