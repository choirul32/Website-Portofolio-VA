---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseCard from "../../components/CaseCard.astro";
import { getCollection } from "astro:content";

const cases = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Selected work"
  description="Client work with verified throughput, and concept projects labelled as concept work. No inflated numbers."
  currentPage="work"
>
  <section class="pt-[clamp(40px,6vw,80px)]">
    <div class="wrap">
      <h1 class="display display-l">Selected work</h1>
      <p class="mt-6 max-w-[62ch] font-light text-body">
        Every entry is labelled. Client work carries verified numbers. Concept work carries none,
        because there are none.
      </p>
    </div>
  </section>

  <section class="sec pt-[clamp(32px,4vw,56px)]">
    <div class="wrap">
      {
        cases.map((entry, i) => (
          <CaseCard entry={entry} href={`/work/${entry.slug}`} showBody={false} flip={i % 2 === 1} />
        ))
      }
    </div>
  </section>
</BaseLayout>
