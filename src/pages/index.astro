---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProofStats from "../components/ProofStats.astro";
import ReachList from "../components/ReachList.astro";
import SectionHead from "../components/SectionHead.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import CaseCard from "../components/CaseCard.astro";
import PhoneMockup from "../components/PhoneMockup.astro";
import Pricing from "../components/Pricing.astro";
import Testimonials from "../components/Testimonials.astro";
import AiWorkflow from "../components/AiWorkflow.astro";
import Faq from "../components/Faq.astro";
import { getCollection } from "astro:content";
import { site, services, process, achievements, upworkProfileUrl } from "../data/site";

const cases = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description="Short-form content operations for agencies and brands. Four client accounts, eight videos a day, published without missing a slot."
  currentPage="home"
>
  <section class="pt-10">
    <div class="wrap">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3.5">
        <span class="text-[13px] font-semibold uppercase tracking-[0.2em] text-ink">
          {site.name}
        </span>
        <p class="max-w-[30ch] text-[15px] font-light leading-relaxed text-body">
          Helping agencies and brands keep a publishing calendar that never goes quiet.
        </p>
      </div>
      <p class="kick mt-[clamp(28px,5vw,56px)] text-muted">Portfolio</p>
      <h1 class="display display-l mt-3">Daily content, handled.</h1>
      <p class="lede mt-5 max-w-[52ch]">
        I run TikTok &amp; Instagram publishing for busy brands — hooks, captions, and posting
        every day, in your voice. You send raw footage, your calendar stays full.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="btn btn-solid" href="#pricing">See packages</a>
        {
          upworkProfileUrl ? (
            <a class="btn btn-outline" href={upworkProfileUrl} target="_blank" rel="noreferrer">
              Hire me on Upwork
            </a>
          ) : (
            <a class="btn btn-outline" href={site.whatsappHref} target="_blank" rel="noreferrer">
              Chat on WhatsApp
            </a>
          )
        }
      </div>
      <hr class="rule mt-[clamp(28px,5vw,56px)]" />
      <div class="flex flex-wrap items-baseline justify-between gap-x-7 gap-y-3 py-[26px]">
        <p
          class="max-w-[18ch] font-sans text-[clamp(20px,4vw,46px)] font-bold uppercase leading-[1.05] tracking-[-0.01em] text-body"
        >
          {site.role}
        </p>
        <span class="script self-end">content that never misses a slot</span>
      </div>
    </div>
  </section>

  <ProofStats />

  <section class="sec" id="about">
    <div class="wrap">
      <SectionHead word="About me" />
      <div class="split">
        <div class="max-w-[420px] overflow-hidden rounded-xs bg-line/40">
          <img
            src="/images/portrait.jpg"
            alt={`${site.name}, standing in a white shirt`}
            width="592"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </div>
        <div class="text-body">
          <p class="font-light">
            I came into content from IT, which is why I treat publishing as a system rather than a
            batch of tasks. A queue that fills itself beats a to-do list someone remembers to check.
          </p>
          <p class="mt-4 font-light">
            That background is also why I build the boring parts: naming conventions, status
            tracking, and handover documents. When a process is written down, it survives a busy
            week, a holiday, and a change of hands.
          </p>
          <p class="mt-4 font-light">
            I work in short-form video because it is daily, measurable, and unforgiving about
            consistency. If a slot is empty, you can see it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="services">
    <div class="wrap">
      <SectionHead word="Services" />
      <div class="split">
        <p class="lede">
          Scoped by outcome, not by hours. Each one removes a specific bottleneck from the content
          pipeline.
        </p>
        <div class="item-grid">
          {
            services.map((service) => (
              <div class="item">
                <span class="service-icon">
                  <ServiceIcon name={service.icon} />
                </span>
                <h3>{service.title}</h3>
                <p>{service.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sec pt-0" id="grids">
    <div class="wrap">
      <SectionHead word="Feed previews" />
      <p class="lede max-w-[62ch]">
        How each system reads on its home platform. Instagram grids for Glowyn, Ruang Seduh,
        and Coach Reza — TikTok feeds for SkillUp and Preloved.
      </p>
      <div class="mt-9 grid gap-8 md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:gap-10">
        <PhoneMockup
          username="glowyn.skincare"
          displayName="GLOWYN Skincare"
          bio="Skincare that helps you glow, naturally."
          highlights={["Ingredients", "Routine", "Reviews", "Glow Tips"]}
          avatarLetter="G"
          caption="Glowyn — sage-green system: education, routine, product, proof."
          tiles={[
            { src: "/images/work/glowyn/tile-1.jpg", alt: "Glowyn serum and moisturizer product duo" },
            { src: "/images/work/glowyn/tile-2.jpg", alt: "Glowyn niacinamide education graphic" },
            { src: "/images/work/glowyn/tile-3.jpg", alt: "Glowyn green tea gel cream product shot" },
            { src: "/images/work/glowyn/tile-4.jpg", alt: "Glowyn morning routine graphic" },
            { src: "/images/work/glowyn/tile-5.jpg", alt: "Glowyn brand statement graphic" },
            { src: "/images/work/glowyn/tile-6.jpg", alt: "Glowyn night routine graphic" },
            { src: "/images/work/glowyn/tile-7.jpg", alt: "Glowyn gentle cleanser product shot" },
            { src: "/images/work/glowyn/tile-8.jpg", alt: "Glowyn centella education graphic" },
            { src: "/images/work/glowyn/tile-9.jpg", alt: "Glowyn hyaluronic acid education graphic" },
          ]}
        />
        <PhoneMockup
          username="ruang.seduh"
          displayName="RUANG SEDUH"
          bio="Teman di setiap seduhan."
          highlights={["Menu", "Coffee", "Ambience", "Events"]}
          avatarLetter="R"
          caption="Ruang Seduh — warm minimal feed: interior, promo, product, quote, craft."
          tiles={[
            { src: "/images/work/ruang-seduh/tile-1.jpg", alt: "Ruang Seduh cafe interior" },
            { src: "/images/work/ruang-seduh/tile-2.jpg", alt: "Ruang Seduh grand opening graphic" },
            { src: "/images/work/ruang-seduh/tile-3.jpg", alt: "Ruang Seduh latte art" },
            { src: "/images/work/ruang-seduh/tile-4.jpg", alt: "Ruang Seduh menu highlight" },
            { src: "/images/work/ruang-seduh/tile-5.jpg", alt: "Ruang Seduh pour-over brewing" },
            { src: "/images/work/ruang-seduh/tile-6.jpg", alt: "Ruang Seduh barista pouring" },
            { src: "/images/work/ruang-seduh/tile-7.jpg", alt: "Ruang Seduh seating corner" },
            { src: "/images/work/ruang-seduh/tile-8.jpg", alt: "Ruang Seduh brand quote" },
            { src: "/images/work/ruang-seduh/tile-9.jpg", alt: "Ruang Seduh iced coffee" },
          ]}
        />
        <PhoneMockup
          username="coach.reza.fit"
          displayName="COACH REZA FIT"
          bio="Disiplin hari ini, hasil hebat di masa depan."
          highlights={["Form", "Program", "Nutrition", "Quotes"]}
          avatarLetter="C"
          caption="Coach Reza — black-and-yellow energy: form checks, offers, proof."
          tiles={[
            { src: "/images/work/coach-reza/tile-1.jpg", alt: "Coach Reza squat form check" },
            { src: "/images/work/coach-reza/tile-2.jpg", alt: "Coach Reza motivational quote" },
            { src: "/images/work/coach-reza/tile-3.jpg", alt: "Coach Reza push up guide" },
            { src: "/images/work/coach-reza/tile-4.jpg", alt: "Coach Reza profile intro" },
            { src: "/images/work/coach-reza/tile-5.jpg", alt: "Coach Reza online coaching pricing" },
            { src: "/images/work/coach-reza/tile-6.jpg", alt: "Coach Reza client transformation" },
            { src: "/images/work/coach-reza/tile-7.jpg", alt: "Coach Reza deadlift form check" },
            { src: "/images/work/coach-reza/tile-8.jpg", alt: "Coach Reza consistency quote" },
            { src: "/images/work/coach-reza/tile-9.jpg", alt: "Coach Reza nutrition guide" },
          ]}
        />
        <PhoneMockup
          username="skillup.academy"
          displayName="SkillUp Academy"
          bio="Skill lebih penting dari IPK. Yuk, upgrade diri!"
          highlights={["Tips", "Kursus", "Karier"]}
          avatarLetter="S"
          platform="tiktok"
          caption="SkillUp — TikTok feed: navy-and-yellow tips, offers, alumni proof."
          tiles={[
            { src: "/images/work/skillup/tile-1.jpg", alt: "SkillUp hook post", ratio: "portrait" },
            { src: "/images/work/skillup/tile-2.jpg", alt: "SkillUp study tips", ratio: "portrait" },
            { src: "/images/work/skillup/tile-3.jpg", alt: "SkillUp bootcamp offer", ratio: "portrait" },
            { src: "/images/work/skillup/tile-4.jpg", alt: "SkillUp Excel shortcut", ratio: "portrait" },
            { src: "/images/work/skillup/tile-5.jpg", alt: "SkillUp alumni testimonial", ratio: "portrait" },
            { src: "/images/work/skillup/tile-6.jpg", alt: "SkillUp in-demand skills", ratio: "portrait" },
            { src: "/images/work/skillup/tile-7.jpg", alt: "SkillUp behind the scenes", ratio: "portrait" },
            { src: "/images/work/skillup/tile-8.jpg", alt: "SkillUp portfolio tips", ratio: "portrait" },
            { src: "/images/work/skillup/tile-9.jpg", alt: "SkillUp flexible learning", ratio: "portrait" },
          ]}
        />
        <PhoneMockup
          username="preloved.bynara"
          displayName="Preloved by Nara"
          bio="Thrift smart, look amazing."
          highlights={["Drop", "Styling", "Packing"]}
          avatarLetter="P"
          platform="tiktok"
          caption="Preloved by Nara — TikTok feed: pastel drops, styling, trust."
          tiles={[
            { src: "/images/work/preloved/tile-1.jpg", alt: "Preloved haul drop", ratio: "portrait" },
            { src: "/images/work/preloved/tile-2.jpg", alt: "Preloved styling challenge", ratio: "portrait" },
            { src: "/images/work/preloved/tile-3.jpg", alt: "Preloved Friday drop", ratio: "portrait" },
            { src: "/images/work/preloved/tile-4.jpg", alt: "Preloved curation process", ratio: "portrait" },
            { src: "/images/work/preloved/tile-5.jpg", alt: "Preloved packing order", ratio: "portrait" },
            { src: "/images/work/preloved/tile-6.jpg", alt: "Preloved thrifting tips", ratio: "portrait" },
            { src: "/images/work/preloved/tile-7.jpg", alt: "Preloved transformation", ratio: "portrait" },
            { src: "/images/work/preloved/tile-8.jpg", alt: "Preloved buyer testimonials", ratio: "portrait" },
            { src: "/images/work/preloved/tile-9.jpg", alt: "Preloved style on budget", ratio: "portrait" },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="sec pt-0" id="work">
    <div class="wrap">
      <SectionHead word="Selected work" />
      {
        cases.map((entry, i) => (
          <CaseCard
            entry={entry}
            href={`/work/${entry.slug}`}
            showBody={i === 0}
            flip={i % 2 === 1}
          />
        ))
      }
    </div>
  </section>

  <section class="sec" id="planning">
    <div class="wrap">
      <SectionHead word="Planning" />
      <div class="split">
        <p class="lede">
          Organized. Consistent. Impactful. Planning happens before a single frame is cut.
        </p>
        <div class="item-grid">
          {
            process.map((item) => (
              <div class="item">
                <span class="service-icon">
                  <ServiceIcon name={item.icon} />
                </span>
                <h3>{item.step}</h3>
                <p>{item.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Pricing />

  <Testimonials />

  <AiWorkflow />

  <Faq />

  <section class="sec pt-0" id="achievement">
    <div class="wrap">
      <SectionHead word="My achievement" />
      <div class="grid gap-0 md:grid-cols-2 md:gap-x-14">
        {
          achievements.map((item) => (
            <div class="ach-item">
              <span class="text-base font-medium text-ink">{item.title}</span>
              <span class="text-xs uppercase tracking-[0.1em] text-muted">{item.issuer}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-brown pt-[clamp(56px,8vw,110px)] text-canvas" id="contact">
    <div class="wrap">
      <p class="text-[clamp(22px,3vw,38px)] font-normal text-cream-90">{site.name}</p>
      <h2 class="display display-l my-[clamp(10px,2vw,22px)] text-canvas">Start with a free sample</h2>
      <div class="split-even">
        <div>
          <p class="max-w-[48ch] text-base font-light text-cream-70">
            Send one long-form video. I return a ready-to-post batch — hooks, cuts, captions —
            free. Keep it if you love it, ignore me if you don't.
          </p>
          <div class="mt-[26px] flex flex-wrap gap-3">
            <a class="btn btn-cream" href={site.whatsappHref} target="_blank" rel="noreferrer">
              Get my free sample
            </a>
            <a class="btn btn-ghost-light" href={`mailto:${site.email}`}>Email instead</a>
          </div>
        </div>
        <ReachList />
      </div>
    </div>
    <p
      class="script px-[22px] pt-[clamp(30px,5vw,60px)] text-center text-[clamp(46px,9vw,118px)] text-cream-90 md:px-10"
    >
      Let's work together
    </p>
  </section>
</BaseLayout>
