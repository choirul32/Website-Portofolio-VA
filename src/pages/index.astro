---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProofStats from "../components/ProofStats.astro";
import ReachList from "../components/ReachList.astro";
import SectionHead from "../components/SectionHead.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import CaseCard from "../components/CaseCard.astro";
import PhoneMockup from "../components/PhoneMockup.astro";
import { getCollection } from "astro:content";
import { site, services, process, achievements } from "../data/site";

const cases = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description="Short-form content operations for agencies and brands. Four client accounts, eight videos a day, published without missing a slot."
  currentPage="home"
>
  <section class="pt-10">
    <div class="wrap">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3.5">
        <span class="text-[13px] font-semibold uppercase tracking-[0.2em] text-ink">
          {site.name}
        </span>
        <p class="max-w-[30ch] text-[15px] font-light leading-relaxed text-body">
          Helping agencies and brands keep a publishing calendar that never goes quiet.
        </p>
      </div>
      <h1 class="display display-xl mt-[clamp(28px,5vw,56px)]">Portfolio</h1>
      <hr class="rule" />
      <div class="flex flex-wrap items-baseline justify-between gap-x-7 gap-y-3 py-[26px]">
        <p
          class="max-w-[18ch] font-sans text-[clamp(20px,4vw,46px)] font-bold uppercase leading-[1.05] tracking-[-0.01em] text-body"
        >
          {site.role}
        </p>
        <span class="script self-end">content that never misses a slot</span>
      </div>
    </div>
  </section>

  <ProofStats />

  <section class="sec" id="about">
    <div class="wrap">
      <SectionHead word="About me" />
      <div class="split">
        <div class="max-w-[420px] overflow-hidden rounded-xs bg-line/40">
          <img
            src="/images/portrait.jpg"
            alt={`${site.name}, standing in a white shirt`}
            width="592"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </div>
        <div class="text-body">
          <p class="font-light">
            I came into content from IT, which is why I treat publishing as a system rather than a
            batch of tasks. A queue that fills itself beats a to-do list someone remembers to check.
          </p>
          <p class="mt-4 font-light">
            That background is also why I build the boring parts: naming conventions, status
            tracking, and handover documents. When a process is written down, it survives a busy
            week, a holiday, and a change of hands.
          </p>
          <p class="mt-4 font-light">
            I work in short-form video because it is daily, measurable, and unforgiving about
            consistency. If a slot is empty, you can see it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="services">
    <div class="wrap">
      <SectionHead word="Services" />
      <div class="split">
        <p class="lede">
          Scoped by outcome, not by hours. Each one removes a specific bottleneck from the content
          pipeline.
        </p>
        <div class="item-grid">
          {
            services.map((service) => (
              <div class="item">
                <span class="service-icon">
                  <ServiceIcon name={service.icon} />
                </span>
                <h3>{service.title}</h3>
                <p>{service.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sec pt-0" id="grids">
    <div class="wrap">
      <SectionHead word="Feed previews" />
      <p class="lede max-w-[62ch]">
        How the grid reads on a phone. Concept previews — handles and numbers blanked on
        purpose, the system is what is real.
      </p>
      <div class="mt-9 grid gap-8 md:grid-cols-2 md:gap-6 lg:gap-10">
        <PhoneMockup
          username="ruang.seduh"
          displayName="RUANG SEDUH"
          bio="Teman di setiap seduhan."
          highlights={["Menu", "Coffee", "Ambience", "Events"]}
          avatarLetter="R"
          caption="Ruang Seduh — warm minimal feed: interior, promo, product, quote, craft."
          tiles={[
            { src: "/images/work/ruang-seduh/cover.jpg", alt: "Ruang Seduh cafe interior", pos: "center 30%" },
            { src: "/images/work/ruang-seduh/feed-grid.jpg", alt: "Ruang Seduh nine-post grid", pos: "center 20%" },
            { src: "/images/work/ruang-seduh/latte.jpg", alt: "Ruang Seduh latte art", pos: "center" },
            { src: "/images/work/ruang-seduh/pour-over.jpg", alt: "Ruang Seduh pour-over brewing", pos: "center" },
            { src: "/images/work/ruang-seduh/cover.jpg", alt: "Ruang Seduh cafe interior", pos: "center 60%" },
            { src: "/images/work/ruang-seduh/latte.jpg", alt: "Ruang Seduh latte art", pos: "center 30%" },
            { src: "/images/work/ruang-seduh/pour-over.jpg", alt: "Ruang Seduh pour-over brewing", pos: "center 70%" },
            { src: "/images/work/ruang-seduh/feed-grid.jpg", alt: "Ruang Seduh nine-post grid", pos: "center 60%" },
            { src: "/images/work/ruang-seduh/cover.jpg", alt: "Ruang Seduh cafe interior", pos: "center 80%" },
          ]}
        />
        <PhoneMockup
          username="glowyn.skincare"
          displayName="GLOWYN Skincare"
          bio="Skincare that helps you glow, naturally."
          highlights={["Ingredients", "Routine", "Reviews", "Glow Tips"]}
          avatarLetter="G"
          caption="Glowyn — sage-green system: education, routine, product, proof."
          tiles={[
            { src: "/images/work/glowyn/feed-grid.jpg", alt: "Glowyn nine-post launch grid", pos: "center 20%" },
            { src: "/images/work/glowyn/cover.jpg", alt: "Glowyn skincare products", pos: "center" },
            { src: "/images/work/glowyn/product-jar.jpg", alt: "Glowyn green tea moisturiser jar", pos: "center" },
            { src: "/images/work/glowyn/brand-graphic.jpg", alt: "Glowyn brand statement graphic", pos: "center" },
            { src: "/images/work/glowyn/feed-grid.jpg", alt: "Glowyn nine-post launch grid", pos: "center 50%" },
            { src: "/images/work/glowyn/product-jar.jpg", alt: "Glowyn green tea moisturiser jar", pos: "center 30%" },
            { src: "/images/work/glowyn/cover.jpg", alt: "Glowyn skincare products", pos: "center 70%" },
            { src: "/images/work/glowyn/brand-graphic.jpg", alt: "Glowyn brand statement graphic", pos: "center 30%" },
            { src: "/images/work/glowyn/feed-grid.jpg", alt: "Glowyn nine-post launch grid", pos: "center 80%" },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="sec pt-0" id="work">
    <div class="wrap">
      <SectionHead word="Selected work" />
      {
        cases.map((entry, i) => (
          <CaseCard
            entry={entry}
            href={`/work/${entry.slug}`}
            showBody={i === 0}
          />
        ))
      }
    </div>
  </section>

  <section class="sec" id="planning">
    <div class="wrap">
      <SectionHead word="Planning" />
      <div class="split">
        <p class="lede">
          Organized. Consistent. Impactful. Planning happens before a single frame is cut.
        </p>
        <div class="item-grid">
          {
            process.map((item) => (
              <div class="item">
                <h3>{item.step}</h3>
                <p>{item.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sec pt-0" id="achievement">
    <div class="wrap">
      <SectionHead word="My achievement" />
      <div class="grid gap-0 md:grid-cols-2 md:gap-x-14">
        {
          achievements.map((item) => (
            <div class="ach-item">
              <span class="text-base font-medium text-ink">{item.title}</span>
              <span class="text-xs uppercase tracking-[0.1em] text-muted">{item.issuer}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-brown pt-[clamp(56px,8vw,110px)] text-canvas" id="contact">
    <div class="wrap">
      <p class="text-[clamp(22px,3vw,38px)] font-normal text-cream-90">{site.name}</p>
      <h2 class="display display-xl my-[clamp(10px,2vw,22px)] text-canvas">Thank you</h2>
      <div class="split-even">
        <div>
          <p class="max-w-[48ch] text-base font-light text-cream-70">
            Send one long-form asset and your publishing calendar. I return a sample batch with
            hooks and captions, so you can judge the work before committing to anything.
          </p>
          <div class="mt-[26px] flex flex-wrap gap-3">
            <a class="btn btn-cream" href={`mailto:${site.email}`}>Email the asset</a>
            <a class="btn btn-ghost-light" href={site.whatsappHref}>WhatsApp</a>
          </div>
        </div>
        <ReachList />
      </div>
    </div>
    <p
      class="script px-[22px] pt-[clamp(30px,5vw,60px)] text-center text-[clamp(46px,9vw,118px)] text-cream-90 md:px-10"
    >
      Let's work together
    </p>
  </section>
</BaseLayout>
